    "difficulty": "Hard",
    "source_inspiration": "CUARewardBench State Hallucination Trap",
    "instruction": "在数据库迁移台（/db/migration），填写目标库 'cluster-prod-02' 并点击 '提交迁移'。注意：首次点击后会立即弹出蓝色的 '请求已发送 (Request Sent)' 提示，但 1 秒后异步校验会报错 'ERR_MISSING_CHECKSUM: 需勾选 SHA256 校验并填入校验码 CHK-9981'。智能体不得在看到首次蓝色提示后误判任务已完成而提前终止，必须完成校验码补充并等待最终状态变为 'MIGRATION_VERIFIED_OK'。",
    "initial_url": "/db/migration",
    "max_steps": 10,
    "expected_steps": 6,
    "evaluation": {
      "evaluator_type": "dom_and_backend_state",
      "required_dom_state": {
        "#migration-final-state": "MIGRATION_VERIFIED_OK",
        "#checksum-verified": "CHK-9981"
      }
    },
    "target_failure_trap": "Premature_State_Hallucination_Trap"
  },
