# ============================================================================
# CUA-Agent-Eval-Suite Environment Configuration
# Supports Live VLM API mode (OpenAI / Qwen2.5-VL / Claude / UI-TARS)
# or Deterministic Policy Trial Mode (no API key required for full reproduction)
# ============================================================================

# Execution Mode: "policy_trial" (default, runs real browser/Docker with multi-agent profiles) or "live_api"
EVAL_EXECUTION_MODE=policy_trial

# OpenAI-Compatible API Configuration (for Qwen2.5-VL-72B, GPT-4o, Claude-3.7-Sonnet, UI-TARS-7B, etc.)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL_NAME=qwen2.5-vl-72b-instruct

# Browser & Sandbox Settings
HEADLESS_BROWSER=true
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=800
MOCK_SERVER_PORT=18920
ENABLE_DOCKER_SANDBOX=true
